{
  "name": "flash-sale-backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "start": "prisma migrate deploy && node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prisma:migrate": "prisma migrate dev"
  },
  "engines": {
    "node": ">=20.6"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "express": "5.2.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "20.19.43",
    "@types/supertest": "7.2.1",
    "prisma": "6.19.3",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
