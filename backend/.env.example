# Local backend run (npm run dev / prisma CLI). Copy to backend/.env.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://flash:flash@localhost:5432/flash_sale

# Used by `npm test`; must point at the postgres-test service and a database whose name ends with _test.
TEST_DATABASE_URL=postgresql://flash:flash@localhost:5433/flash_sale_test
